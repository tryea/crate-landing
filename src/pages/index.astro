---
import "../styles/globals.css";

/*
 * Crate marketing landing — Mercury LP grammar single-anchor commit
 * per DEC-006. Light-only.
 *
 * Layout (top → bottom):
 *   1. HERO — eyebrow + headline + subhead + primary CTA (demo) + secondary email capture + scope disclaimer
 *   2. TRUST STRIP — 4 verifiable stats (mono labels, R=G=B neutral-gray bg)
 *   3. WHAT IT DOES — 3 equal-status feature cards (NO bento per ui-audit hierarchy honesty)
 *   4. FOOTER — single-paragraph wayfinding (app link, repo link)
 *
 * Founder testimonial + asymmetric feature sections (Mercury full grammar)
 * land in next iteration once positioning copy is locked.
 */

const trustStrip = [
  { value: "90/90", label: "Jest specs · domain logic" },
  { value: "0", label: "cross-tenant leaks · CI-asserted" },
  { value: "5", label: "SKUs · live demo" },
  { value: "16", label: "valuation specs · WAC" },
];

const features = [
  {
    title: "Append-only ledger",
    body:
      "Every movement is a row in stock_movements. No edits, no deletes — corrections happen via adjustment movements with a recorded reason.",
  },
  {
    title: "Atomic transfers",
    body:
      "A→B moves run in one Postgres transaction with SELECT FOR UPDATE row locks. Half-completed transfers are mathematically impossible.",
  },
  {
    title: "Perpetual WAC valuation",
    body:
      "Weighted-average cost recalculated on every receive. 16 Jest specs cover the math — the dashboard total is the same math the tests assert.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Crate — ops-grade inventory management. Append-only ledger, atomic transfers, perpetual weighted-average valuation. Open the live demo."
    />
    <meta property="og:title" content="Crate — ops-grade inventory management" />
    <meta
      property="og:description"
      content="An inventory system built around how stock actually moves. Live demo: app.crate.ersaptaaristo.dev."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://crate.ersaptaaristo.dev/" />
    <title>Crate — ops-grade inventory management</title>
  </head>
  <body class="bg-canvas text-ink">
    <main>
      <!-- HERO -->
      <section class="bg-canvas border-b border-border-soft">
        <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
          <p class="font-mono text-xs uppercase tracking-widest text-ink-soft mb-6">
            For warehouse operations
          </p>
          <h1 class="text-5xl sm:text-6xl font-semibold tracking-tight text-ink max-w-3xl">
            Stock you can actually trust.
          </h1>
          <p class="mt-6 text-lg text-ink-mute max-w-2xl leading-relaxed">
            An inventory system built around how stock actually moves.
            Append-only ledger, atomic transfers, audit log everything.
            Made for operators who'd rather read the receipt than trust the dashboard.
          </p>

          <!-- Primary CTA: try the live demo. Secondary: email for invite-only future. -->
          <div class="mt-10 flex flex-col sm:flex-row gap-3 items-start">
            <a
              href="https://app.crate.ersaptaaristo.dev/sign-in"
              class="inline-flex items-center gap-2 rounded-md bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
            >
              Open the live demo
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M5 3l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <a
              href="#what-it-does"
              class="inline-flex items-center gap-2 rounded-md border border-border bg-canvas px-5 py-2.5 text-sm font-medium text-ink hover:bg-canvas-alt transition-colors"
            >
              How it works
            </a>
          </div>
          <p class="mt-4 text-xs text-ink-soft max-w-xl">
            Demo: <code class="font-mono text-ink">admin@crate.local</code>
            <span aria-hidden="true">/</span>
            <code class="font-mono text-ink">ChangeMe!Admin</code>. Seeded data only — no spam, no email gate, no signup.
          </p>
        </div>
      </section>

      <!-- TRUST STRIP — 4 verifiable stats -->
      <section class="bg-canvas-alt border-b border-border-soft">
        <div class="mx-auto max-w-6xl px-6 py-12">
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-8">
            {trustStrip.map((stat) => (
              <div class="flex flex-col gap-1.5">
                <div class="text-3xl font-semibold tracking-tight text-ink">
                  {stat.value}
                </div>
                <div class="font-mono text-xs uppercase tracking-wider text-ink-soft">
                  {stat.label}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- WHAT IT DOES — 3 equal-status cards (NO bento per ui-audit hierarchy honesty) -->
      <section id="what-it-does" class="bg-canvas border-b border-border-soft">
        <div class="mx-auto max-w-6xl px-6 py-24">
          <div class="max-w-2xl mb-12">
            <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-ink">
              How stock actually moves.
            </h2>
            <p class="mt-4 text-lg text-ink-mute leading-relaxed">
              Three guarantees the data layer enforces — not three features
              the UI promises.
            </p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {features.map((feature) => (
              <div class="flex flex-col gap-3 rounded-lg border border-border-soft bg-surface p-6">
                <h3 class="text-lg font-semibold text-ink">{feature.title}</h3>
                <p class="text-sm text-ink-mute leading-relaxed">{feature.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- FOOTER — wayfinding only, no copywriter prose -->
      <footer class="bg-canvas py-12">
        <div class="mx-auto max-w-6xl px-6 flex flex-col sm:flex-row gap-4 sm:items-center sm:justify-between">
          <p class="text-sm text-ink-soft">
            Crate — a portfolio project by Sapta.
          </p>
          <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
            <a href="https://app.crate.ersaptaaristo.dev"
               class="text-ink-mute hover:text-ink underline-offset-4 hover:underline">
              Live demo
            </a>
            <a href="https://github.com/tryea/crate-webapp"
               class="text-ink-mute hover:text-ink underline-offset-4 hover:underline">
              App repo
            </a>
            <a href="https://github.com/tryea/crate-landing"
               class="text-ink-mute hover:text-ink underline-offset-4 hover:underline">
              Landing repo
            </a>
          </div>
        </div>
      </footer>
    </main>
  </body>
</html>
