---
import "../styles/globals.css";

/*
 * Crate marketing landing.
 *
 * The hero is the artefact itself: a live HTML ledger table, not a picture of
 * one. Two of its rows carry the same second and the same reference with
 * opposite signs, which is the whole atomicity argument made without a sentence
 * of explanation. Product screenshots still appear, but lower, where they show
 * the same table running rather than standing in for it.
 *
 * Order:
 *   header
 *   1. hero        eyebrow, headline, lead, CTA pair, the ledger table
 *   2. thesis      what the two marked rows prove
 *   3. numbers     four figures, each one countable by the reader in the repo
 *   4. how         three rules the database enforces
 *   5. movements   DARK band, the same table running
 *   6. orders      the five-state machine
 *   7. verify      three places to check without taking my word
 *   8. closer      one CTA plus a recap of what the thing is
 *   footer
 *
 * EVERY NUMBER HERE IS COUNTABLE BY THE READER. Two claims were removed rather
 * than repaired: "20 decision records", whose link answered 404 because those
 * documents are not published, and "223 unit specs, 13 suites", which no reader
 * could arrive at from the public repo. What is left is 14 files matching
 * e2e/*.spec.ts and 16 unit spec files under src/**\/__tests__, both counted
 * from the tree of main on 1 Sep 2026 and both countable again by anyone.
 *
 * Demo credentials are deliberately absent from this page.
 */

const APP = "https://app.crate.ersaptaaristo.dev";
const DEMO = `${APP}/sign-in`;
const REPO = "https://github.com/tryea/crate-webapp";
const CI = `${REPO}/actions/workflows/ci.yml`;
const LANDING_REPO = "https://github.com/tryea/crate-landing";

const mark =
  "M4 3h22a2 2 0 0 1 2 2v1.5a2 2 0 0 1-2 2H10v14h16a2 2 0 0 1 2 2V26a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z";

/* Five rows of the seeded demo, read at one moment. Rows three and four are the
   pair: one transaction, one reference, one second, opposite signs. */
const rows = [
  {
    when: "Aug 12, 2026 16:35",
    type: "Adjustment",
    name: "Cold Brew Coffee 250ml",
    sku: "BEV-002",
    bin: "A1",
    qty: "-2",
    dir: "out",
    reason: "count correction",
    ref: "none",
    pair: false,
  },
  {
    when: "Aug 12, 2026 15:10",
    type: "Stock out",
    name: "All-Purpose Cleaner 1L",
    sku: "CLN-001",
    bin: "A1",
    qty: "-9",
    dir: "out",
    reason: "sale",
    ref: "SO-2026-0217",
    pair: false,
  },
  {
    when: "Aug 12, 2026 11:50",
    type: "Transfer in",
    name: "Gel Pen 0.5mm, box of 12",
    sku: "STA-002",
    bin: "B1",
    qty: "+12",
    dir: "in",
    reason: "transfer",
    ref: "TRF-2026-0061",
    pair: true,
  },
  {
    when: "Aug 12, 2026 11:50",
    type: "Transfer out",
    name: "Gel Pen 0.5mm, box of 12",
    sku: "STA-002",
    bin: "A2",
    qty: "-12",
    dir: "out",
    reason: "transfer",
    ref: "TRF-2026-0061",
    pair: true,
  },
  {
    when: "Aug 12, 2026 08:20",
    type: "Stock in",
    name: "Mineral Water 600ml",
    sku: "BEV-001",
    bin: "A1",
    qty: "+480",
    dir: "in",
    reason: "purchase",
    ref: "PO-2026-011",
    pair: false,
  },
];

const nums = [
  { n: "14", k: "End-to-end spec files", how: "e2e/*.spec.ts on main" },
  { n: "16", k: "Unit spec files", how: "src/**/__tests__" },
  { n: "1", k: "Table allowed to move stock", how: "stock_movements" },
  { n: "0", k: "Rows ever edited or deleted", how: "by design, not by policy" },
];

const rules = [
  {
    num: "01",
    title: "Append-only ledger",
    body: "Every movement is one row. A correction is its own new row with a reason attached, so both the mistake and the fix survive.",
  },
  {
    num: "02",
    title: "Atomic transfers",
    body: "A move between bins runs as one transaction holding SELECT FOR UPDATE row locks. Half a transfer is not a value this schema can store.",
  },
  {
    num: "03",
    title: "Perpetual weighted-average cost",
    body: "Cost is recalculated on every receipt. The total on the dashboard is produced by the same function the unit tests assert against.",
  },
];

const notes = [
  {
    title: "Paired",
    body: "A transfer writes two rows sharing one group id. Either both land or neither does.",
  },
  {
    title: "Attributed",
    body: "Every row carries its author and an absolute timestamp. No relative time anywhere.",
  },
  {
    title: "Bounded",
    body: "Stock cannot go negative unless an admin turns on backorder, and that switch is itself an audited setting.",
  },
];

const checks = [
  {
    title: "Open it",
    body: "The demo is public and seeded. Move some stock and watch the ledger disagree with nobody.",
    href: DEMO,
    url: "app.crate.ersaptaaristo.dev",
  },
  {
    title: "Read it",
    body: "Every line, including the migrations, the row-level security policies, and the tests that back the numbers above.",
    href: REPO,
    url: "github.com/tryea/crate-webapp",
  },
  {
    title: "Watch it run",
    body: "CI runs the static gates on every pull request and the full Playwright suite on main.",
    href: CI,
    url: "actions/workflows/ci.yml",
  },
];

const recap = [
  ["Stack", "Next.js, TypeScript, Postgres"],
  ["Access control", "row-level security"],
  ["Stock writes", "one table, append only"],
  ["Source", "public"],
  ["Sign-up required", "none"],
];

const description =
  "Crate keeps every stock movement as a row and adds them up. Open the live demo or read the source.";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>Crate, an append-only inventory ledger</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="Crate, an append-only inventory ledger" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://crate.ersaptaaristo.dev/" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="hdr">
      <div class="wrap">
        <a class="brand" href="#top">
          <svg viewBox="0 0 32 32" aria-hidden="true"><path d={mark} /></svg>
          Crate
        </a>
        <a class="navlink" href="#how">How it works</a>
        <a class="navlink" href="#verify">Verify</a>
        <a class="btn btn-go" href={DEMO}>Open the live demo</a>
      </div>
    </header>

    <main id="main">
      <!-- 1. HERO. The ledger is the hero image, and it is real markup, so a
           reader can select a row and read the reference out of it. -->
      <section class="hero" id="top">
        <div class="wrap">
          <p class="eyebrow eyebrow-soft">Append-only inventory ledger</p>
          <h1>Every number here is a sum of rows you can read.</h1>
          <p class="lead">
            Most inventory tools keep a stock count and let the app edit it.
            Crate keeps the movements and adds them up, so a mistake stays on
            the page with its reason and its author.
          </p>
          <div class="cta-row">
            <a class="btn btn-go" href={DEMO}>Open the live demo</a>
            <a class="btn btn-ghost" href={REPO}>Read the source</a>
          </div>

          <div class="ledger">
            <div class="ledger-head">
              <span class="eyebrow">stock_movements</span>
              <span class="mono stamp">append only &middot; no update &middot; no delete</span>
            </div>
            <table>
              <thead>
                <tr>
                  <th>When (UTC+7)</th>
                  <th>Type</th>
                  <th>Product</th>
                  <th class="hide-sm">Bin</th>
                  <th class="right">Qty</th>
                  <th class="hide-md">Reason</th>
                  <th class="hide-md">Reference</th>
                </tr>
              </thead>
              <tbody>
                {
                  rows.map((r) => (
                    <tr class={r.pair ? "pair" : undefined}>
                      <td class={r.pair ? "t pair-mark" : "t"}>{r.when}</td>
                      <td><span class="tag">{r.type}</span></td>
                      <td>
                        <div class="name">{r.name}</div>
                        <div class="sku">{r.sku}</div>
                      </td>
                      <td class="hide-sm t">{r.bin}</td>
                      <td class={`qty ${r.dir}`}>{r.qty}</td>
                      <td class="hide-md t">{r.reason}</td>
                      <td class="hide-md t">{r.ref}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- 2. THESIS. Names what the two marked rows prove, once. -->
      <section class="thesis wrap">
        <p class="lead-in">
          The two marked rows carry one second, one reference, and opposite
          signs.
        </p>
        <p>
          That pair is a single Postgres transaction. A transfer that moved out
          of A2 but never arrived in B1 is not a state this database is able to
          hold, so it is not a bug that can be reported. On hand is never
          stored: it is the sum of this table, read at query time.
        </p>
      </section>

      <!-- 3. NUMBERS. Each one has the path a reader counts it from. -->
      <section class="band">
        <div class="wrap nums">
          {
            nums.map((s) => (
              <div>
                <div class="n">{s.n}</div>
                <div class="k">{s.k}</div>
                <div class="how mono">{s.how}</div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- 4. RULES. Constraints, not features. -->
      <section class="sec" id="how">
        <div class="wrap">
          <h2>Three rules the database enforces.</h2>
          <p class="sub">
            Not three features the interface promises. Each one is a constraint,
            which means the application cannot opt out of it on a bad day.
          </p>
          <div class="rules">
            {
              rules.map((r) => (
                <div class="rule">
                  <p class="eyebrow num">{r.num}</p>
                  <h3>{r.title}</h3>
                  <p>{r.body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 5. MOVEMENTS, dark band. The same table, running. -->
      <section class="sec dark">
        <div class="wrap">
          <p class="eyebrow">The part nobody screenshots</p>
          <h2 class="spaced">This is the same table, running.</h2>
          <p class="sub">
            Filter it, sort it, scroll it. Every row carries who did it and
            when, to the minute, in a date you can read rather than a relative
            time that hides the year.
          </p>
          <img
            class="shot shot-wide"
            src="/shots/movements.png"
            width="1440"
            height="900"
            alt="Crate movements screen: an append-only ledger of stock changes with type, product, bin, quantity, reason and reference columns."
          />
          <div class="notes">
            {
              notes.map((n) => (
                <div>
                  <p class="eyebrow">{n.title}</p>
                  <p>{n.body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 6. ORDERS. The state that most tools skip. -->
      <section class="sec">
        <div class="wrap">
          <h2>Ordering, in the five states it really has.</h2>
          <p class="sub">
            Draft, sent, partial, received, cancelled. Partial is the one that
            matters and the one most tools skip: a receipt of forty against an
            order of sixty leaves twenty outstanding, and the order says so.
          </p>
          <img
            class="shot shot-wide"
            src="/shots/orders.png"
            width="1440"
            height="900"
            alt="Crate purchase orders screen showing draft, sent, partial, received and cancelled states with expected and created dates."
          />
        </div>
      </section>

      <!-- 7. VERIFY. A ruled list, not a third card grid. -->
      <section class="sec band" id="verify">
        <div class="wrap">
          <p class="eyebrow eyebrow-soft">Nothing here needs my word for it</p>
          <h2 class="spaced">Check it yourself, in three places.</h2>
          <div class="checks">
            {
              checks.map((c) => (
                <a class="check" href={c.href}>
                  <h3>{c.title}</h3>
                  <p>{c.body}</p>
                  <p class="url mono">{c.url}</p>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 8. CLOSER. One action, and a recap that fills the second column. -->
      <section class="sec">
        <div class="wrap closer">
          <div>
            <h2>Open it and try to break the count.</h2>
            <p class="sub">
              Sell more than you hold. Cancel a half-received order. Correct a
              count twice. The number will still be a sum of rows you can read.
            </p>
            <div class="cta-row">
              <a class="btn btn-go" href={DEMO}>Open the live demo</a>
              <a class="btn btn-ghost" href={REPO}>Read the source</a>
            </div>
          </div>
          <div class="recap">
            {
              recap.map(([k, v]) => (
                <div class="recap-row">
                  <span>{k}</span>
                  <span>{v}</span>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer class="ft">
      <div class="wrap">
        <span class="who">
          <svg viewBox="0 0 32 32" aria-hidden="true"><path d={mark} /></svg>
          Crate, a portfolio project by Sapta.
        </span>
        <nav>
          <a href={APP}>Live demo</a>
          <a href={REPO}>App repo</a>
          <a href={LANDING_REPO}>Landing repo</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
